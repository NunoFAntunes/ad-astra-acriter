---
import Wordmark from './Wordmark.astro';
import bulbWebm from '../assets/hourglass.webm';
import bulbMp4 from '../assets/hourglass.mp4';
import bulbPoster from '../assets/hourglass-poster.jpg';
import neckWebm from '../assets/hourglass-neck.webm';
import neckMp4 from '../assets/hourglass-neck.mp4';
import neckPoster from '../assets/hourglass-neck-poster.jpg';
import type { HeroSources, HeroVariant } from '../scripts/hero-variant';

// Variants under review (switched from HeroSettings). The first is the default
// and what renders without JS; each has a matching mask in the styles below.
const SOURCES: Record<HeroVariant, HeroSources> = {
  bulb: { webm: bulbWebm, mp4: bulbMp4, poster: bulbPoster.src },
  neck: { webm: neckWebm, mp4: neckMp4, poster: neckPoster.src },
};
const { bulb } = SOURCES;
---

<main class="hero">
  <h1 class="sr-only">Ad Astra Acriter</h1>

  <div class="hourglass" data-variant="bulb" data-sources={JSON.stringify(SOURCES)} aria-hidden="true">
    <video muted loop playsinline autoplay preload="auto" poster={bulb.poster} width="1280" height="720">
      <source src={bulb.webm} type="video/webm" />
      <source src={bulb.mp4} type="video/mp4" />
    </video>
  </div>

  <div class="stage">
    <p class="line" data-line="1">In a changing world</p>
    <p class="line" data-line="2">We must rethink</p>
    <Wordmark open data-hero-mark />
  </div>
</main>

<script>
  import { bindHeroVariant } from '../scripts/hero-variant';
  import { runIntro } from '../scripts/intro';

  const hourglass = document.querySelector<HTMLElement>('.hourglass');
  if (hourglass) bindHeroVariant(hourglass);
  runIntro();
</script>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(20px, 3.5vh, 44px);
    padding: 0 var(--gutter) calc(var(--header-h) * .8);
    min-width: 0;
  }

  .hourglass {
    width: min(88vw, 760px, (100svh - var(--header-h) - 260px) * 16 / 9);
    min-width: 260px;
    aspect-ratio: 16 / 9;
  }

  .hourglass video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    -webkit-mask-image: url("../assets/hourglass-mask.png");
            mask-image: url("../assets/hourglass-mask.png");
    -webkit-mask-size: 100% 100%;
            mask-size: 100% 100%;
    -webkit-mask-repeat: no-repeat;
            mask-repeat: no-repeat;
  }

  .hourglass[data-variant="neck"] video {
    -webkit-mask-image: url("../assets/hourglass-neck-mask.png");
            mask-image: url("../assets/hourglass-neck-mask.png");
  }

  .stage {
    display: grid;
    place-items: center;
    min-height: 2.4em;
    font-size: clamp(22px, 2.6vw, 36px);
  }

  .stage > * { grid-area: 1 / 1; }

  .line {
    margin: 0;
    /* the lines share the mark's grid cell; keep them from blocking its hover */
    pointer-events: none;
    user-select: none;
    font-weight: 330;
    letter-spacing: .02em;
    text-align: center;
  }

  .stage :global(.wordmark) {
    --track: .26em;
    --gap-open: .5em;
    font-size: min(1.25em, 5.6vw);
    position: relative;
    cursor: default;
    user-select: none;
  }

  /* The collapsed ΛΛΛ is a small target; pad the hover area without moving it. */
  .stage :global(.wordmark)::before {
    content: '';
    position: absolute;
    inset: -.5em -.6em;
  }

  /* Intro choreography (classes toggled by scripts/intro.ts). Without JS,
     the end state is shown. */

  :global(.js) .hourglass,
  :global(.js) .line,
  :global(.js) .stage :global(.wordmark) {
    opacity: 0;
  }

  .hourglass {
    transform: scale(1.015);
    transition:
      opacity 2.2s var(--ease-soft),
      transform 3.2s var(--ease-out);
  }

  .line {
    transform: translateY(10px);
    filter: blur(6px);
    transition:
      opacity 1.3s var(--ease-soft),
      transform 1.6s var(--ease-out),
      filter 1.3s var(--ease-soft);
  }

  .line.is-out {
    transform: translateY(-6px);
    filter: blur(5px);
    transition-duration: 1s, 1.1s, 1s;
  }

  .stage :global(.wordmark) {
    --dur-close: 1.7s;
    --close-delay: .45s;
    --fade-in: 1s;
    --fade-out: .8s;
    --lit-delay: .35s;
    --stagger: 55ms;
    transition: opacity 1.4s var(--ease-soft);
  }

  :global(.js) .hourglass.is-in,
  :global(.js) .line.is-in,
  :global(.js) .stage :global(.wordmark.is-in) { opacity: 1; }

  .hourglass.is-in,
  .line.is-in { transform: none; filter: blur(0); }

  /* Variant switch (scripts/hero-variant.ts): quick fade out, then the
     usual slow fade back in once the new clip has a frame. */
  :global(.js) .hourglass.is-in.is-swapping {
    opacity: 0;
    transition-duration: .45s;
  }

  .line.is-in.is-out { opacity: 0; transform: translateY(-6px); filter: blur(5px); }
</style>
