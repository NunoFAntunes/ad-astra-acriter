---
import Wordmark from './Wordmark.astro';

interface Props {
  /** Start hidden and let the page intro fade the header in. */
  intro?: boolean;
}

const { intro = false } = Astro.props;

// Hidden for now: only Inquire shows. Flip to bring the sections back.
const SHOW_NAV = false;

const NAV = [
  { href: '#philosophy', label: 'Philosophy' },
  { href: '#advisory', label: 'Advisory' },
  { href: '#perspectives', label: 'Perspectives' },
  { href: '#contact', label: 'Contact' },
];
---

<header class:list={['site-header', { 'no-nav': !SHOW_NAV }]} data-intro={intro || undefined}>
  <a class="site-logo" href={import.meta.env.BASE_URL} aria-label="Ad Astra Acriter — home">
    <Wordmark />
  </a>

  {SHOW_NAV && (
    <nav class="site-nav" id="site-nav" aria-label="Main">
      {NAV.map(({ href, label }) => <a href={href}>{label}</a>)}
    </nav>
  )}

  <div class="site-actions">
    <!-- The address is assembled by the script so it isn't in the HTML for scrapers. -->
    <div class="inquire" data-user="customer" data-domain="aaastrategy.eu">
      <div class="inquire-reveal" id="inquire-reveal" inert>
        <div class="inquire-reveal-inner">
          <a class="inquire-address"></a>
          <button class="inquire-copy" type="button">Copy</button>
        </div>
      </div>
      <a class="inquire-trigger" aria-controls="inquire-reveal"><span class="dot" aria-hidden="true"></span>Inquire</a>
    </div>
    {SHOW_NAV && <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">Menu</button>}
  </div>
</header>

<script>
  import { bindHover, watchSize } from '../scripts/wordmark';

  function bindMenu(toggle: HTMLButtonElement, nav: HTMLElement): void {
    const set = (open: boolean) => {
      nav.classList.toggle('is-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.textContent = open ? 'Close' : 'Menu';
    };
    toggle.addEventListener('click', () => set(!nav.classList.contains('is-open')));
    nav.addEventListener('click', (e) => { if (e.target instanceof Element && e.target.closest('a')) set(false); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') set(false); });
  }

  // Phones (and narrow windows) go straight to the mail app. Desktops often have
  // no mail app set up, so there Inquire unrolls the address with a copy button.
  const REVEAL = '(hover: hover) and (pointer: fine) and (min-width: 760px)';

  function bindInquire(root: HTMLElement): void {
    const trigger = root.querySelector<HTMLAnchorElement>('.inquire-trigger');
    const reveal = root.querySelector<HTMLElement>('.inquire-reveal');
    const address = root.querySelector<HTMLAnchorElement>('.inquire-address');
    const copy = root.querySelector<HTMLButtonElement>('.inquire-copy');
    if (!trigger || !reveal || !address || !copy) return;

    const email = `${root.dataset.user}@${root.dataset.domain}`;
    const mailto = `mailto:${email}?subject=${encodeURIComponent('Inquiry')}`;
    trigger.href = mailto;
    address.href = mailto;
    address.textContent = email;

    const isOpen = () => root.classList.contains('is-open');
    const set = (open: boolean) => {
      root.classList.toggle('is-open', open);
      reveal.inert = !open;
      trigger.setAttribute('aria-expanded', String(open));
    };

    trigger.addEventListener('click', (e) => {
      if (!matchMedia(REVEAL).matches) return;
      e.preventDefault();
      set(!isOpen());
    });

    let reset: ReturnType<typeof setTimeout> | undefined;
    copy.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(email);
        copy.textContent = 'Copied';
      } catch {
        // Clipboard blocked: select the address so Cmd/Ctrl+C still works.
        getSelection()?.selectAllChildren(address);
        return;
      }
      clearTimeout(reset);
      reset = setTimeout(() => { copy.textContent = 'Copy'; }, 1600);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape' || !isOpen()) return;
      set(false);
      trigger.focus();
    });
    document.addEventListener('click', (e) => {
      if (isOpen() && e.target instanceof Node && !root.contains(e.target)) set(false);
    });
  }

  const inquire = document.querySelector<HTMLElement>('.inquire');
  if (inquire) bindInquire(inquire);

  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.querySelector<HTMLElement>('#site-nav');
  if (toggle && nav) bindMenu(toggle, nav);

  const logo = document.querySelector<HTMLElement>('.site-logo');
  const mark = logo?.querySelector<HTMLElement>('[data-wordmark]');
  if (logo && mark) {
    document.fonts.ready.then(() => {
      watchSize(mark);
      bindHover(logo, mark);
    });
  }
</script>

<style>
  .site-header {
    position: relative;
    z-index: 10;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 0 var(--gutter);
    font-size: 13px;
    font-weight: 450;
    letter-spacing: .3em;
    text-transform: uppercase;
  }

  .site-header.no-nav { grid-template-columns: 1fr auto; }

  /* Intro: hidden until the hero script adds .is-in. Without JS it stays visible. */
  .site-header[data-intro] { transition: opacity 1.6s var(--ease-soft); }
  :global(.js) .site-header[data-intro]:not(.is-in) { opacity: 0; }

  .site-logo {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    /* generous hit area without shifting the mark */
    padding: 12px 12px 12px 0;
    margin: -12px 0;
    /* as large as the open name allows before it meets the nav (at 1281px) */
    font-size: clamp(24px, 2.05vw, 32px);
    letter-spacing: 0;
  }

  .site-logo :global(.wordmark) {
    --track: .24em;
    --gap-open: .5em;
  }

  .site-logo :global(.wm-letters) { color: var(--muted); }

  .site-nav {
    display: flex;
    gap: clamp(28px, 4vw, 72px);
  }

  .site-nav a,
  .inquire-trigger {
    position: relative;
    padding: 8px 0;
    color: var(--muted);
    transition: color .4s var(--ease-soft);
  }

  .site-nav a:hover,
  .site-nav a:focus-visible,
  .inquire-trigger:hover,
  .inquire-trigger:focus-visible { color: var(--ink); }

  .site-actions {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .inquire {
    display: flex;
    align-items: center;
  }

  .inquire-trigger {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--ink);
    cursor: pointer;
    /* balance the trailing letter-spacing */
    margin-right: -.3em;
  }

  .inquire .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--red);
    transition: transform .5s var(--ease-out);
  }

  .inquire-trigger:hover .dot,
  .inquire.is-open .dot { transform: scale(1.35); }

  /* The address unrolls leftwards out of the dot: the column grows from 0fr to 1fr. */
  .inquire-reveal {
    display: grid;
    grid-template-columns: 0fr;
    opacity: 0;
    transition:
      grid-template-columns .7s var(--ease-out),
      opacity .4s var(--ease-soft);
  }

  .inquire.is-open .inquire-reveal {
    grid-template-columns: 1fr;
    opacity: 1;
    transition:
      grid-template-columns .7s var(--ease-out),
      opacity .5s var(--ease-soft) .15s;
  }

  .inquire-reveal-inner {
    display: flex;
    align-items: center;
    gap: 20px;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    /* room for the focus outline inside the clipped column */
    padding: 8px 28px 8px 8px;
  }

  .inquire-address {
    font-size: 14px;
    letter-spacing: .06em;
    text-transform: none;
    color: var(--ink);
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat;
    padding-bottom: 2px;
    transition: background-size .5s var(--ease-out);
  }

  .inquire-address:hover,
  .inquire-address:focus-visible { background-size: 100% 1px; }

  .inquire-copy {
    appearance: none;
    border: 0;
    background: none;
    padding: 8px 0;
    font: inherit;
    font-size: 11px;
    letter-spacing: inherit;
    text-transform: inherit;
    color: var(--muted);
    cursor: pointer;
    transition: color .4s var(--ease-soft);
  }

  .inquire-copy:hover,
  .inquire-copy:focus-visible { color: var(--ink); }

  .menu-toggle {
    display: none;
    appearance: none;
    border: 0;
    background: none;
    padding: 8px 0;
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    color: var(--muted);
    cursor: pointer;
  }

  @media (max-width: 1280px) {
    .site-header { grid-template-columns: 1fr auto; }

    .site-nav {
      position: fixed;
      inset: var(--header-h) 0 auto 0;
      flex-direction: column;
      align-items: center;
      gap: 0;
      padding: 24px var(--gutter) 40px;
      background: var(--bg);
      font-size: 14px;
      opacity: 0;
      visibility: hidden;
      transform: translateY(-6px);
      transition:
        opacity .5s var(--ease-soft),
        transform .6s var(--ease-out),
        visibility 0s linear .6s;
    }

    .site-nav a { padding: 16px 0; }

    .site-nav.is-open {
      opacity: 1;
      visibility: visible;
      transform: none;
      transition:
        opacity .5s var(--ease-soft),
        transform .6s var(--ease-out);
    }

    .menu-toggle { display: block; }
  }
</style>
