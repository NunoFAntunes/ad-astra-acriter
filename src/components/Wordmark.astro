---
import type { HTMLAttributes } from 'astro/types';
import singleA from '../assets/logo/AAA_single_A.svg?raw';
import logo from '../assets/logo/AAA_logo.svg?raw';

type Props = HTMLAttributes<'span'> & {
  /** Render expanded ("AD ASTRA ACRITER") instead of the collapsed ΛΛΛ. */
  open?: boolean;
};

const { open = false, class: className, ...rest } = Astro.props;

// Each word is a Λ glyph followed by its tail. Letters carry a running
// index (--i) so the fade-in can stagger across the whole name.
const TAILS = ['D', 'STRA', 'CRITER'];
let i = 0;
const words = TAILS.map((tail) => [...tail].map((char) => ({ char, i: i++ })));

// The Λ comes straight from the logo files (src/assets/logo): the single A's
// outline and its shaded inner leg, spaced as in the three-A logo, so the
// collapsed mark is the logo itself.
const [, , A_W, A_H] = singleA.match(/viewBox="([^"]+)"/)![1].split(/\s+/).map(Number);
const paths = [...singleA.matchAll(/<path\b[^>]*>/g)].map(([tag]) => ({
  d: tag.match(/\sd="([^"]+)"/)![1],
  rgb: tag.match(/fill(?:="|:)#([0-9a-f]{6})/i)![1].match(/../g)!.map((h) => parseInt(h, 16)),
}));
const [{ d: body, rgb: bodyRgb }, { d: facet, rgb: facetRgb }] = paths;
// The shade is drawn as black over the A's colour, so it follows the colour
// the mark is set in (red in the header, white over the hero reel).
const SHADE = (1 - facetRgb.reduce((a, c, k) => a + c / bodyRgb[k], 0) / 3).toFixed(3);
const offsets = [...logo.matchAll(/translate\((-?[\d.]+)/g)].map((m) => Number(m[1])).sort((a, b) => a - b);
const GAP = ((offsets[1] - offsets[0] - A_W) / A_H).toFixed(4);
---

<span class:list={['wordmark', { 'is-open': open }, className]} data-wordmark aria-hidden="true" style={`--a-ratio:${A_W / A_H};--gap-ratio:${GAP}`} {...rest}>
  {words.map((letters) => (
    <span class="wm-word">
      <svg class="wm-a" viewBox={`0 0 ${A_W} ${A_H}`}><path d={body} fill="currentColor" /><path d={facet} fill="#000" fill-opacity={SHADE} /></svg>
      <span class="wm-tail"><span class="wm-letters">{letters.map(({ char, i }) => <span style={`--i:${i}`}>{char}</span>)}</span></span>
    </span>
  ))}
</span>

<style>
  /* Three Λ glyphs are the logo. Each is followed by a "tail"
     (D / STRA / CRITER) whose width animates between 0 and the
     measured natural width (--w, set in scripts/wordmark.ts). */

  .wordmark {
    --cap: .7em;                                  /* Jost cap height */
    --a-w: calc(var(--cap) * var(--a-ratio));
    --gap-closed: calc(var(--cap) * var(--gap-ratio));   /* logo spacing */
    --gap-open: .42em;
    --track: .2em;

    --dur-open: .8s;
    --dur-close: .7s;
    --close-delay: .1s;
    --fade-in: .5s;
    --fade-out: .26s;
    --lit-delay: .12s;
    --stagger: 18ms;

    display: inline-flex;
    align-items: baseline;
    line-height: 1;
    /* stems as thick as the logo's Λ legs (≈ .11 of the cap height) */
    font-weight: 370;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .wm-word { display: inline-flex; align-items: baseline; }

  .wm-word + .wm-word {
    margin-left: var(--gap-closed);
    transition: margin-left var(--dur-close) var(--ease-in-out) var(--close-delay);
  }

  .wm-a {
    width: var(--a-w);
    height: var(--cap);
    flex: none;
    color: var(--red);
    overflow: visible;
  }

  .wm-tail {
    display: inline-block;
    width: 0;
    /* clip-path instead of overflow:hidden so the baseline stays on the text */
    clip-path: inset(-.4em 0 -.4em 0);
    transition: width var(--dur-close) var(--ease-in-out) var(--close-delay);
  }

  .wm-letters {
    display: inline-block;
    width: max-content;
    padding-left: calc(var(--track) * .9);
  }

  .wm-letters > span {
    display: inline-block;
    letter-spacing: var(--track);
    opacity: 0;
    filter: blur(3px);
    transition:
      opacity var(--fade-out) var(--ease-soft),
      filter var(--fade-out) var(--ease-soft);
  }

  .wm-letters > span:last-child { letter-spacing: 0; }

  .wordmark.is-open .wm-tail {
    width: var(--w, auto);
    transition: width var(--dur-open) var(--ease-out);
  }

  .wordmark.is-open .wm-word + .wm-word {
    margin-left: var(--gap-open);
    transition: margin-left var(--dur-open) var(--ease-out);
  }

  .wordmark.is-lit .wm-letters > span {
    opacity: 1;
    filter: blur(0);
    transition:
      opacity var(--fade-in) var(--ease-soft) calc(var(--lit-delay) + var(--i) * var(--stagger)),
      filter var(--fade-in) var(--ease-soft) calc(var(--lit-delay) + var(--i) * var(--stagger));
  }

  /* collapse without animating (end state on return visits) */
  .wordmark.no-anim *, .wordmark.no-anim { transition: none !important; }
</style>
