# Production deploy to the OVH web hosting (tools/deploy-ovh.sh).
# Copy to .env.deploy (git-ignored) and fill in the password. The same keys
# are GitHub secrets of the "production" environment for the CI deploy.
OVH_SFTP_HOST=ftp.cluster129.hosting.ovh.net
OVH_SFTP_PORT=22
OVH_SFTP_USER=aaastrc
OVH_SFTP_PASSWORD=
# Site root, relative to the home dir /home/aaastrc (OVH Manager > Multisite).
OVH_REMOTE_DIR=www
